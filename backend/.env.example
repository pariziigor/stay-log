# =============================================================================
# Backend Environment Configuration
# =============================================================================

# Application
# development | test | production. Fora de development/test a API se recusa a iniciar
# com SECRET_KEY fraca (< 32 caracteres ou valor padrão) ou com DATABASE_URL em SQLite.
ENVIRONMENT=development
PROJECT_NAME="Sistema de Gestão Inteligente para Locação por Temporada"
API_V1_STR=/api/v1
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-ultra-secure-random-secret-key-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Formato: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://locacao:troque-esta-senha@localhost:5432/locacao

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security / Rate limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# AI Assistant (Opcional - 100% Gratuito via Google AI Studio ou Groq)
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq Cloud (alternativa gratuita): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
