# =============================================================================
# Backend Environment Configuration
# =============================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="Sistema de Gestão Inteligente para Locação por Temporada"
API_V1_STR=/api/v1
SECRET_KEY=change-this-ultra-secure-random-secret-key-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Formato: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://locacao:troque-esta-senha@localhost:5432/locacao

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security / Rate limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
